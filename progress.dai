    <bpmn:task id="task_idchtspk" name="HUD, menus &#38; audio" dai:notes="ui/hud.ts: canvas HUD (speed/alt/AGL, throttle+rpm, compass ribbon with airfield and enemy carets, objective, ammo/heat, damage silhouette, minimap, enemy brackets + off-screen arrows, lead diamond, reticle, landing guide with glide-slope advice). menus.ts: hangar (mission, difficulty, assists, seed + reroll, quality, best record), loading bar, pause (volume, shake, invert), debrief with medal. audio.ts: synthesised engine with putt modulation, wind, guns, hits, explosions, splash, positional enemy engines. Not done: background music." dai:agentStatus="done" dai:planRef="task_ltt0d26a">
      <bpmn:incoming>flow_g5yrazaj</bpmn:incoming>
