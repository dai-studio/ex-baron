    <bpmn:startEvent id="event_yrskl8q7" name="Start">
      <bpmn:outgoing>flow_o8sbehfi</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="task_qfhx3y6q" name="1. Scaffold project" dai:notes="Vite + TypeScript + three.js + vitest. index.html with canvas, WebGL 2 check and fallback message. (design §6 Vite + TypeScript, three; §5 Context loss &#38; fallback)" dai:agentStatus="done">
      <bpmn:incoming>flow_o8sbehfi</bpmn:incoming>
      <bpmn:outgoing>flow_j0zicclm</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="flow_o8sbehfi" sourceRef="event_yrskl8q7" targetRef="task_qfhx3y6q" />
    <bpmn:task id="task_l3k5pldm" name="2. Core engine" dai:notes="Fixed 120 Hz game loop with render interpolation, input (keyboard, mouse, gamepad), GameStateMachine, settings in localStorage. (design §6)" dai:agentStatus="done">
      <bpmn:incoming>flow_j0zicclm</bpmn:incoming>
      <bpmn:outgoing>flow_ms8ttgg6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="flow_j0zicclm" sourceRef="task_qfhx3y6q" targetRef="task_l3k5pldm" />
    <bpmn:task id="task_ohjh4os8" name="3. World generation core" dai:notes="Seeded RNG, noise, terrain height function, biome colours. One shared module used by the main thread and workers. (design §4)" dai:agentStatus="done">
      <bpmn:incoming>flow_ms8ttgg6</bpmn:incoming>
      <bpmn:outgoing>flow_06dihye9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="flow_ms8ttgg6" sourceRef="task_l3k5pldm" targetRef="task_ohjh4os8" />
    <bpmn:task id="task_x5rl918x" name="4. Chunk streaming &#38; LOD" dai:notes="Chunks in a Worker pool, LOD rings around the camera, LRU cache, upload budget. (design §4 Chunk streaming &#38; LOD)" dai:agentStatus="done">
      <bpmn:incoming>flow_06dihye9</bpmn:incoming>
      <bpmn:outgoing>flow_pf5oze65</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="flow_06dihye9" sourceRef="task_ohjh4os8" targetRef="task_x5rl918x" />
    <bpmn:task id="task_mccwnl4j" name="5. Toon rendering pipeline" dai:notes="Toon lighting material, inverted-hull outlines, gradient sky, stylised fog, edge-detect post pass + FXAA, quality tiers. (design §5)" dai:agentStatus="done">
      <bpmn:incoming>flow_pf5oze65</bpmn:incoming>
      <bpmn:outgoing>flow_pzxfyjdw</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="flow_pf5oze65" sourceRef="task_x5rl918x" targetRef="task_mccwnl4j" />
    <bpmn:task id="task_khqq1w83" name="6. Clouds, water, airfields &#38; props" dai:notes="Procedural toon clouds, toon water, airfield placement with flattened strip, instanced trees and buildings. (design §4, §5)" dai:agentStatus="done">
      <bpmn:incoming>flow_pzxfyjdw</bpmn:incoming>
      <bpmn:outgoing>flow_cuydmcu0</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="flow_pzxfyjdw" sourceRef="task_mccwnl4j" targetRef="task_khqq1w83" />
    <bpmn:task id="task_isi6t5e9" name="7. Biplane, flight model &#38; camera" dai:notes="Procedural low-poly original biplane mesh with animated prop and control surfaces; force-based flight model with ground handling; chase/cockpit cameras. (design §3)" dai:agentStatus="done">
      <bpmn:incoming>flow_cuydmcu0</bpmn:incoming>
      <bpmn:outgoing>flow_sog3hjdu</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="flow_cuydmcu0" sourceRef="task_khqq1w83" targetRef="task_isi6t5e9" />
    <bpmn:task id="task_ok0shzfp" name="8. Combat: guns, damage, enemy AI, effects" dai:notes="Ray-cast bullets with tracers, damage zones, AI pilot state machine on the same flight model, particle effects. (design §3, §5 Effects)" dai:agentStatus="done">
      <bpmn:incoming>flow_sog3hjdu</bpmn:incoming>
      <bpmn:outgoing>flow_nlm5c2ay</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="flow_sog3hjdu" sourceRef="task_isi6t5e9" targetRef="task_ok0shzfp" />
    <bpmn:task id="task_ltt0d26a" name="9. HUD, menus &#38; audio" dai:notes="Cartoon-style HUD and minimap, hangar/pause/debrief screens, synthesised Web Audio engine, guns and explosions. (design §3 HUD &#38; UI, Audio)" dai:agentStatus="done">
      <bpmn:incoming>flow_nlm5c2ay</bpmn:incoming>
      <bpmn:outgoing>flow_429kxt8o</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="flow_nlm5c2ay" sourceRef="task_ok0shzfp" targetRef="task_ltt0d26a" />
    <bpmn:task id="task_nzky8od5" name="10. Gameplay loop: takeoff → land" dai:notes="Wire up the sortie flow: hangar → takeoff → flight → dogfight → return → landing grade → crash/debrief. (design §2)" dai:agentStatus="done">
      <bpmn:incoming>flow_429kxt8o</bpmn:incoming>
      <bpmn:outgoing>flow_koi4rn68</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="flow_429kxt8o" sourceRef="task_ltt0d26a" targetRef="task_nzky8od5" />
    <bpmn:task id="task_44e737qz" name="11. Tests &#38; verification" dai:notes="Determinism unit test, typecheck, production build, run in a browser and check for console errors. (design §7)" dai:agentStatus="done">
      <bpmn:incoming>flow_koi4rn68</bpmn:incoming>
      <bpmn:outgoing>flow_ry7d50pd</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="flow_koi4rn68" sourceRef="task_nzky8od5" targetRef="task_44e737qz" />
    <bpmn:endEvent id="event_blqfau9s" name="Playable build">
      <bpmn:incoming>flow_mmplzxh6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="task_dm9i0pir" name="12. Loadout &#38; spec composer" dai:notes="Loadout type, airframe/engine/wheel definitions, composeSpec(), per-airframe gear and crash points in the flight model, engine spool and thrust curves, jet flame input. Saved in localStorage and ?plane= URL param. (design §8.1)" dai:agentStatus="done">
      <bpmn:incoming>flow_ry7d50pd</bpmn:incoming>
      <bpmn:outgoing>flow_kepafjor</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="task_0fp4papg" name="13. Airframe, engine &#38; wheel meshes" dai:notes="Generalise BiplaneVisual into buildPlane(loadout): Biplane, Turboprop, Jet airframes; 2-blade prop, 4-blade prop, jet nozzle + flame; 3 wheel sizes; 8 paint liveries. (design §8.2)" dai:agentStatus="done">
      <bpmn:incoming>flow_kepafjor</bpmn:incoming>
      <bpmn:outgoing>flow_qdjluo5x</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="flow_kepafjor" sourceRef="task_dm9i0pir" targetRef="task_0fp4papg" />
    <bpmn:task id="task_rpikw3qw" name="14. Upgraded runway &#38; surfaces" dai:notes="900 m paved runway with grass shoulders and overruns, markings, edge lights, PAPI, bigger hangars; longer site search and flattening; surfaceAt() and per-surface wheel grip. (design §8.3)" dai:agentStatus="done">
      <bpmn:incoming>flow_qdjluo5x</bpmn:incoming>
      <bpmn:outgoing>flow_oo0h2nz2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="flow_qdjluo5x" sourceRef="task_0fp4papg" targetRef="task_rpikw3qw" />
    <bpmn:task id="task_1zwngb8u" name="15. Hangar screen &#38; preview" dai:notes="Hangar UI with Plane / Paint / Engine / Wheels tabs, option cards, stat bars, keyboard &#38; gamepad navigation, 3D turntable preview in the main canvas. (design §8.1)" dai:agentStatus="done">
      <bpmn:incoming>flow_oo0h2nz2</bpmn:incoming>
      <bpmn:outgoing>flow_gev9los5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="flow_oo0h2nz2" sourceRef="task_rpikw3qw" targetRef="task_1zwngb8u" />
    <bpmn:task id="task_dvofzdw4" name="16. Engine audio &#38; HUD per type" dai:notes="Engine sound profiles for prop, turbo and jet; HUD throttle shows RPM or spool; debrief shows the loadout. (design §8.2)" dai:agentStatus="done">
      <bpmn:incoming>flow_gev9los5</bpmn:incoming>
      <bpmn:outgoing>flow_z6j6wkxu</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="flow_gev9los5" sourceRef="task_1zwngb8u" targetRef="task_dvofzdw4" />
    <bpmn:task id="task_07tcv09h" name="17. Loadout tests &#38; verification" dai:notes="Every-loadout takeoff/landing matrix test, runway-fits-terrain test, typecheck, build, browser check. (design §8.3 tests)" dai:agentStatus="done">
      <bpmn:incoming>flow_z6j6wkxu</bpmn:incoming>
      <bpmn:outgoing>flow_gzgfhhnp</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="flow_z6j6wkxu" sourceRef="task_dvofzdw4" targetRef="task_07tcv09h" />
    <bpmn:sequenceFlow id="flow_ry7d50pd" sourceRef="task_44e737qz" targetRef="task_dm9i0pir" />
    <bpmn:task id="task_snxp38pz" name="18. Engine comes with the plane" dai:notes="Drop the Engine category: Biplane = prop, Turboprop = turbo, Jet = jet. Remove mixed-engine art (jet pods on prop planes, prop on the jet) and prop-size limits. Loadout = style + paint + wheels (72 combos); ?plane=style.paint.wheels, old 4-part links still work. (design §8)" dai:agentStatus="done">
      <bpmn:incoming>flow_gzgfhhnp</bpmn:incoming>
      <bpmn:outgoing>flow_smw80fx5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="flow_gzgfhhnp" sourceRef="task_07tcv09h" targetRef="task_snxp38pz" />
    <bpmn:task id="task_9q2fvc4u" name="19. Biplane +25% engine power" dai:notes="The biplane felt underpowered: raise its engine thrust by 25% (DEFAULT_SPEC.maxThrust 2600 → 3250 N; the prop engine&#39;s thrust-to-weight derives from it). Turboprop and jet unchanged. Keep composeSpec(default) === DEFAULT_SPEC. (design §8.2)" dai:agentStatus="done">
      <bpmn:incoming>flow_smw80fx5</bpmn:incoming>
      <bpmn:outgoing>flow_r9z9st55</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="flow_smw80fx5" sourceRef="task_snxp38pz" targetRef="task_9q2fvc4u" />
    <bpmn:task id="task_occljhoy" name="20. Route planner" dai:notes="Pure, testable game/route.ts: build the flight path from the home runway (take off into the wind) to a chosen destination airfield (land into the wind). Departure climb straight out, smooth curved cruise leg (no turns tighter than a gentle bank), straight-in final on a 4° glide slope to the threshold. Cruise altitude clears the terrain along the way with climb/descent rate limits. Airfield names from their bearing from home. Tests: every destination on many seeds, terrain clearance, turn radius, glide slope, ends on the runway." dai:agentStatus="done">
      <bpmn:incoming>flow_r9z9st55</bpmn:incoming>
      <bpmn:outgoing>flow_3im13sxj</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="flow_r9z9st55" sourceRef="task_9q2fvc4u" targetRef="task_occljhoy" />
    <bpmn:task id="task_son5gpi7" name="21. 3D guide arrows" dai:notes="Transparent white chevron arrows placed along the route in 3D space, pointing along the path; only the stretch ahead of the plane is shown, fading in with distance; progress along the path tracked from the plane position. Visible from behind and above." dai:agentStatus="done">
      <bpmn:incoming>flow_3im13sxj</bpmn:incoming>
      <bpmn:outgoing>flow_hwi12com</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="flow_3im13sxj" sourceRef="task_occljhoy" targetRef="task_son5gpi7" />
    <bpmn:task id="task_f7byx3za" name="22. Mission select &#38; route map" dai:notes="Main menu Mission choice: Free flight / Cross-country. Cross-country shows a destination picker (◀ name ▶, also ← → keys) and a map of the terrain with both airfields and the flight path, distance and estimated time. Saved in settings." dai:agentStatus="done">
      <bpmn:incoming>flow_hwi12com</bpmn:incoming>
      <bpmn:outgoing>flow_bkp9s4s6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="flow_hwi12com" sourceRef="task_son5gpi7" targetRef="task_f7byx3za" />
    <bpmn:task id="task_no4tehb3" name="23. Cross-country mission logic &#38; verification" dai:notes="Sortie in route mode: arrows shown, objective with destination and distance, HUD marker toward the path when off it, route on the minimap. Success = landing at the destination; path-following accuracy shown in the debrief and part of the medal. Best record per seed + destination. Tests, tsc, build, browser check." dai:agentStatus="done">
      <bpmn:incoming>flow_bkp9s4s6</bpmn:incoming>
      <bpmn:outgoing>flow_mmplzxh6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="flow_bkp9s4s6" sourceRef="task_f7byx3za" targetRef="task_no4tehb3" />
    <bpmn:sequenceFlow id="flow_mmplzxh6" sourceRef="task_no4tehb3" targetRef="event_blqfau9s" />
  </bpmn:process>
